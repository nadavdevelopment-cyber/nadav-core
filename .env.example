NADAV_CORE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
NADAV_CORE_RESTAURANT_ID=00000000-0000-4000-8000-000000000001
NADAV_CORE_DEMO_MODE=true
NADAV_CORE_ADMIN_TOKEN=
NADAV_CORE_SESSION_SECRET=

