{
  "name": "nadav-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless-first restaurant infrastructure by NADAV",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/core-api --hostname 0.0.0.0",
    "dev:core": "next dev apps/core-api --hostname 0.0.0.0",
    "dev:demo": "next dev apps/demo --hostname 0.0.0.0 --port 3001",
    "build": "npm run build:core && npm run build:demo && npm run build:starter",
    "build:core": "next build apps/core-api --webpack",
    "build:demo": "next build apps/demo --webpack",
    "build:starter": "next build starters/nadav-restaurant-starter --webpack",
    "start": "next start apps/core-api --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:sql": "bash scripts/test-sql.sh",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "create:restaurant": "node scripts/create-restaurant.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
